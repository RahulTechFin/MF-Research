# Supabase Storage — holds the 8 Market Pulse index files.
#
# LOCAL USE
#   Copy to `.env` in the repo root and fill in the service key.
#   `.env` is gitignored; THIS file is not, so never put the real key here.
#
# GITHUB ACTIONS
#   Set the same three as repository secrets:
#     Settings -> Secrets and variables -> Actions -> New repository secret
#   .github/workflows/update_indices.yml reads them.
#
# Without these, update_indices.py refuses to publish rather than looking
# healthy while uploading nothing. The rest of the pipeline is unaffected: the
# calculation engine reads index history from the committed
# data/index_history.json.gz, not from Supabase.

# Project URL. Not a secret — it ships in any browser client.
SUPABASE_URL=https://qhxofgrntftnxqdhottd.supabase.co

# SECRET. The service_role key, from
#   Supabase dashboard -> Project Settings -> API -> service_role / secret
# It can write to Storage, so it belongs only in .env or a GitHub secret —
# never in the frontend, never committed.
SUPABASE_SERVICE_KEY=PASTE_SERVICE_ROLE_KEY_HERE

# Bucket holding the 8 index files, one per index, at the root:
#   nifty-50.json  sensex.json  nifty-100.json  nifty-midcap-150.json
#   nifty-smallcap-250.json  nifty-bank.json  nifty-500.json  gold-goldbees.json
#
# Must be a PUBLIC bucket: the deployed site reads these through the
# netlify.toml proxy with no key at all. Quoted because the name has a space.
SUPABASE_BUCKET="Indicies Data"
