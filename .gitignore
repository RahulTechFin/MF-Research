# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Secrets — the admin password verifier lives in site/.env.local and must
# never be committed. .env.team IS committed: it only sets VITE_PROFILE=team.
.env
.env.local
.env.*.local
site/.env.local

# Databases are disposable build artifacts, never stored.
# The scheme universe lives in data/scheme_catalogue.json, which IS committed.
data/*.db
data/*.db-wal
data/*.db-shm

# Google Sheets backup credentials + local checkpoint
secrets/
data/gsheets_backup_state.json

# Frontend
site/node_modules/
site/dist/
site/.vite/

# Pre-built JSON (committed to repo for Netlify static hosting)
# The dashboard's data is NOT in git any more. It lives in the public Supabase
# "MF Data" bucket, which netlify.toml proxies as /data/*. Committing ~2,500 files
# nightly made Netlify rebuild and re-upload the whole site: ~15 min a deploy,
# ~450 min a month against a 300-min allowance. Now only code changes build.
#
# scripts/publish_data.py uploads it; scripts/daily_run.py still writes it here
# first, so this stays a real local directory — just an untracked one.
site/public/data/

# Logs & pytest
*.log
.pytest_cache/
.coverage

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

# The rolling 6-year index window is a mirror of what lives in Supabase Storage
# (scripts/index_store.py), rebuilt by every run — so it is a cache, not source.
# data/index_history.json.gz IS committed: it is the read-only 2010-onward seed
# that makes the first run work against an empty bucket.
data/index_store.json.gz
data/index_store.json.gz.part

# Intermediate flat output from the pipeline (MF_OUTPUT_DIR). The published
# layout is built from it into site/public/data; neither is committed.
build/
